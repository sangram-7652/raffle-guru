# Copy to .env.local for local development. Never commit the real file.

# Base URL of the Laravel API, reached through the Nginx reverse proxy.
# Public (NEXT_PUBLIC_*) because the browser calls it directly — never put
# secrets in a NEXT_PUBLIC_* variable, they are bundled into client JS.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser). Used by
# Server Components/generateMetadata, which run inside this container and
# can't reach the host-published Nginx port above. In Docker this is set
# to http://nginx/api by docker-compose.yml already; only needed here if
# running `npm run dev` directly on the host against Docker's other
# services (point it at http://localhost:8080/api in that case too).
# API_INTERNAL_URL=http://localhost:8080/api
