APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Same origin as APP_URL here (Nginx serves both) — see config/app.php.
FRONTEND_URL=http://localhost:8080
# Browser origins allowed to call the API (comma-separated, explicit — never
# '*'). Defaults to FRONTEND_URL when unset; local Docker adds the direct
# web port in docker-compose.yml.
# CORS_ALLOWED_ORIGINS=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Dev default: writes to storage/logs/laravel.log, fine for a
# bind-mounted container you can tail directly. Production (P12.1,
# immutable image, no log volume — see docker-compose.prod.yml) should
# instead set LOG_CHANNEL=stderr: Docker's own json-file driver
# captures and rotates it (see the `logging:` block on each prod
# service) without relying on the ephemeral container filesystem,
# which is destroyed on every redeploy regardless of Laravel-side
# rotation settings. See docs/PRODUCTION_ARCHITECTURE.md
# "Observability". Production should also raise LOG_LEVEL above
# "debug" (e.g. "warning") to avoid noisy, high-volume logs.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# In Docker, DB_HOST/REDIS_HOST are overridden to the service names
# ("mysql", "redis") by docker-compose.yml — these defaults are for running
# `php artisan serve` directly on the host against the Docker-published ports.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3310
DB_DATABASE=raffleguru
DB_USERNAME=raffleguru
DB_PASSWORD=raffleguru

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Left unset (not a hardcoded production domain) — the cookie then applies
# to whatever host actually served the request, dev or prod alike.
SESSION_DOMAIN=null
# false in dev (plain HTTP over localhost); MUST be true in production
# (HTTPS-only) — set explicitly per environment, never guessed at runtime.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Browser-facing origins (host:port, no protocol) that receive session-
# cookie (not bearer-token) API authentication — see config/sanctum.php.
# This MUST be the origin the browser actually navigates to (the Nginx
# entry point), not an internal Docker service name.
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6390

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Razorpay (P6) — see docs/PAYMENTS_API.md. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# "razorpay" (default) or "fake" — see docs/PAYMENTS_DESIGN_P6.md "Test
# gateway". Only set to "fake" for local verification without a real
# Razorpay account; never in production (enforced — see
# App\Providers\PaymentServiceProvider).
PAYMENT_GATEWAY=razorpay

# Sentry (P12.1) — error tracking, see docs/PRODUCTION_ARCHITECTURE.md
# "Observability". Leaving this empty disables the SDK completely (no
# network calls at all) — intentional for local/testing/CI; set a real
# DSN only for the environment that should actually report, normally
# production only. Never commit a real value. SENTRY_ENVIRONMENT is
# deliberately not set here — the SDK falls back to APP_ENV on its own.
SENTRY_LARAVEL_DSN=

# Backups (P12.2) — see docs/BACKUPS_DISASTER_RECOVERY.md. Defaults work
# out of the box in dev/Docker (storage/app/backups, 14-day retention).
# Production MUST set BACKUP_PATH to the mounted "backup-data" volume
# path (docker-compose.prod.yml) — never leave it on the container's own
# ephemeral filesystem.
# BACKUP_PATH=/var/backups/raffleguru
# BACKUP_RETENTION_DAYS=14

# Off-server backup (P12.6) — see docs/BACKUPS_DISASTER_RECOVERY.md
# "Off-server backup (P12.6)". Disabled by default; local backup
# behavior above is completely unaffected either way. A DEDICATED
# bucket/credential pair — never reuse AWS_* (that's reserved for any
# future user/media upload feature; a compromised backup credential and
# a compromised media credential must stay two separate blast radii).
# Works with any S3-compatible provider (AWS S3, DigitalOcean Spaces,
# Cloudflare R2, MinIO for local/CI testing, etc.) via
# BACKUP_OFFSITE_ENDPOINT + path-style addressing.
BACKUP_OFFSITE_ENABLED=false
# BACKUP_OFFSITE_KEY=
# BACKUP_OFFSITE_SECRET=
# BACKUP_OFFSITE_BUCKET=
# BACKUP_OFFSITE_REGION=auto
# BACKUP_OFFSITE_ENDPOINT=
# BACKUP_OFFSITE_USE_PATH_STYLE_ENDPOINT=true
# BACKUP_OFFSITE_RETENTION_DAYS=30
