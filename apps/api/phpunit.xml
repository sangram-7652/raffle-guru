<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The CLI default (128M) is the app's, not the suite's: the full
             run peaks just above it (~129M at 651 tests; e.g. P9's
             5,000-ticket randomness fixture), so give the suite room. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>

        <!-- P12.6 — off-server backup tests (#[Group('mysql')], see
             docs/BACKUPS_DISASTER_RECOVERY.md "Off-server backup
             (P12.6)") run against a REAL S3-compatible MinIO instance,
             never a mock. Deliberately NOT force="true": these are
             local-dev-friendly defaults (a MinIO container started the
             same way docs/BACKUPS_DISASTER_RECOVERY.md documents), and
             CI (.github/workflows/ci.yml's "mysql" job) overrides them
             with its own real process env vars pointing at its own
             MinIO service container — exactly the same force-vs-real-
             env pattern BACKUP_DUMP_BINARY/BACKUP_TLS_DISABLE_FLAG
             already use for the mariadb-client-vs-Oracle-client split. -->
        <env name="BACKUP_OFFSITE_TEST_ENDPOINT" value="http://127.0.0.1:9000"/>
        <env name="BACKUP_OFFSITE_TEST_KEY" value="raffleguru_backup_test"/>
        <env name="BACKUP_OFFSITE_TEST_SECRET" value="raffleguru_backup_test_secret"/>
        <env name="BACKUP_OFFSITE_TEST_BUCKET" value="raffleguru-backups-test"/>
    </php>
</phpunit>
