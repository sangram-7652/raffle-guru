# Monorepo-wide ignores. Each app also has its own .gitignore for
# language/framework-specific artifacts (apps/web/.gitignore,
# apps/api/.gitignore) — this file only covers cross-cutting concerns.

# OS / editor
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
*.swp

# env files anywhere in the repo — never commit real credentials.
# Each app's own *.env.example is the template that IS committed.
.env
.env.*
!.env.example
!**/.env.example

# Docker
docker-compose.override.yml

# misc logs
*.log
npm-debug.log*
