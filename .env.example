# Variables consumed by docker-compose.yml / docker-compose.prod.yml
# (docker compose reads a root .env automatically). Copy to .env and fill
# in real values for production — never commit the real file.
#
# Local dev (docker-compose.yml) already has safe built-in defaults for
# all of these except NEXT_PUBLIC_API_URL, so a root .env is optional there.

DB_DATABASE=raffleguru
DB_USERNAME=raffleguru
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Public base URL of the API as reached from the browser (through Nginx).
NEXT_PUBLIC_API_URL=https://api.example.com/api
